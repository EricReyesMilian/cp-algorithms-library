   "    Diff2D(int n, int m) : n(n), m(m), d(n + 2, vll(m + 2, 0)) {}",
   "    void add(int x1, int y1, int x2, int y2, ll v) { d[x1][y1] += v; d[x1][y2 + 1] -= v; d[x2 + 1][y1] -= v; d[x2 + 1][y2 + 1] += v; }",
